# ========================================================
# Hilokal Web Environment Variables
# ========================================================

# App Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_hilokal_development_2026_xyz987
JWT_EXPIRES_IN=7d

# MongoDB (Local Docker Instance)
# Format: mongodb://<user>:<password>@<host>:<port>/<dbname>?authSource=admin
MONGODB_URI=mongodb://admin:adminpassword123@localhost:27017/hilokal_db?authSource=admin

# Redis (Caching, Presence & Task Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword123

# Media Storage (Served natively via /public/uploads/ - zero Docker overhead)
NEXT_PUBLIC_STORAGE_BASE_URL=http://localhost:3000

# LiveKit WebRTC Audio Engine
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretvalue992834019283401928340192
LIVEKIT_WS_URL=ws://localhost:7880
NEXT_PUBLIC_LIVEKIT_WS_URL=ws://localhost:7880

# Google Gemini API (Free Tier for AI Grammar, Summaries & Flashcards)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
